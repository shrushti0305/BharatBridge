    instruction: "Implement PCM streaming in toggleListening for live sessions"
    replacement_infos {
      original_chunk {
        target_content: "  const toggleListening = () => {\n    if (isListening) {\n      recognitionRef.current?.stop();\n    } else {\n      setInputText(\"\");\n      recognitionRef.current?.start();\n      setIsListening(true);\n    }\n  };\n"
        replacement_content: "  const toggleListening = async () => {\n    if (isListening) {\n      if (isLive) {\n        if (inputAudioCtxRef.current) {\n          inputAudioCtxRef.current.close();\n          inputAudioCtxRef.current = null;\n        }\n        setIsListening(false);\n      } else {\n        recognitionRef.current?.stop();\n      }\n      return;\n    }\n\n    if (isLive) {\n      try {\n        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\n        setIsListening(true);\n\n        if (!inputAudioCtxRef.current) {\n          inputAudioCtxRef.current = new AudioContext({ sampleRate: 16000 });\n        }\n        const ctx = inputAudioCtxRef.current;\n        const source = ctx.createMediaStreamSource(stream);\n        const processor = ctx.createScriptProcessor(4096, 1, 1);\n        \n        source.connect(processor);\n        processor.connect(ctx.destination);\n\n        processor.onaudioprocess = (e) => {\n          const pcm = e.inputBuffer.getChannelData(0);\n          const base64 = pcmToBase64(pcm);\n          \n          if (ws && ws.readyState === WebSocket.OPEN) {\n            ws.send(JSON.stringify({ type: \"audio\", audio: base64 }));\n          }\n        };\n      } catch (error) {\n        console.error(\"Microphone access denied:\", error);\n        alert(\"Microphone access is required for live translation.\");\n      }\n    } else {\n      setInputText(\"\");\n      recognitionRef.current?.start();\n      setIsListening(true);\n    }\n  };\n"
      }
      num_matches: 1
    }
  }
