        }
        lines {
          text: "        {modalOpen.open && modalOpen.type !== \"profile\" && ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <LanguageModal "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            isOpen={modalOpen.open} "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            title={modalOpen.type === \"source\" ? \"Source Selection\" : \"Target Selection\"}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            onClose={() => setModalOpen({ ...modalOpen, open: false })}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            selectedCode={modalOpen.type === \"source\" ? sourceLang.code : targetLang.code}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            onSelect={(lang) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              if (modalOpen.type === \"source\") setSourceLang(lang);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              else setTargetLang(lang);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
