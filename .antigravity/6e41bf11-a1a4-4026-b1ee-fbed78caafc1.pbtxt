        lines {
          text: "function pcmToBase64(float32Array: Float32Array): string {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const buffer = new ArrayBuffer(float32Array.length * 2);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const view = new DataView(buffer);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  for (let i = 0; i < float32Array.length; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const s = Math.max(-1, Math.min(1, float32Array[i]));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    view.setInt16(i * 2, s < 0 ? s * 0x8000 : s * 0x7FFF, true);"
