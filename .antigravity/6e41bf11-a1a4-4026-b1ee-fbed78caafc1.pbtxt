        replacement_content: "    ws.on(\"close\", () => {\n      if (currentSessionId && sessions.has(currentSessionId)) {\n        const session = sessions.get(currentSessionId)!;\n        if (isSpeaker) {\n          session.speaker = null;\n          if (session.geminiSession) {\n            session.geminiSession.close();\n            session.geminiSession = null;\n          }\n        } else {\n          session.listeners.delete(ws);\n        }\n\n        // Broadcast updated count\n        const countPayload = JSON.stringify({ type: \"stats\", listeners: session.listeners.size });\n        if (session.speaker?.readyState === WebSocket.OPEN) session.speaker.send(countPayload);\n        session.listeners.forEach(l => {\n          if (l.readyState === WebSocket.OPEN) l.send(countPayload);\n        });\n      }\n    });"
      }
      num_matches: 1
    }
