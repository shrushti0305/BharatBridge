    instruction: "Update the Join Live Session logic to allow listeners to select their preferred regional language. Ensure the WebSocket join message includes the listener\'s target language so the server can provide personalized real-time translation. Also, update the UI to provide a clearer \'Speaker\' vs \'Listener\' role selection in the Bharat Bridge portal."
    replacement_infos {
      original_chunk {
        target_content: "              {!isLive ? (\n                <div className=\"z-10 w-full space-y-6\">\n                  <div className=\"bg-slate-900/80 border border-blue-500/30 p-5 rounded-2xl w-full text-center backdrop-blur-md\">\n                    <p className=\"text-[10px] text-blue-300 uppercase mb-4 tracking-widest\">Processing Matrix</p>\n                    <div className=\"grid grid-cols-4 gap-2 opacity-60\">\n                      {Array.from({ length: 8 }).map((_, i) => (\n                        <motion.div \n                          key={i}\n                          animate={isTranslating ? { opacity: [0.2, 1, 0.2] } : { opacity: 0.2 }}\n                          transition={{ repeat: Infinity, duration: 1, delay: i * 0.1 }}\n                          className=\"h-3 bg-blue-500/40 rounded-sm\"\n                        />\n                      ))}\n                    </div>\n                  </div>\n\n                  <div className=\"grid grid-cols-2 gap-3\">\n                    <button \n                      onClick={startLiveSession}\n                      className=\"flex flex-col items-center justify-center gap-2 p-4 bg-orange-500/10 border border-orange-500/20 rounded-2xl hover:bg-orange-500/20 transition-all group\"\n                    >\n                      <Mic size={20} className=\"text-orange-400 group-hover:scale-110 transition-transform\" />\n                      <span className=\"text-[10px] font-bold text-white uppercase tracking-widest\">Go Live</span>\n                    </button>\n                    <button \n                      onClick={() => {\n                        const id = prompt(\"Enter Session ID:\");\n                        if (id) joinLiveSession(id);\n                      }}\n                      className=\"flex flex-col items-center justify-center gap-2 p-4 bg-blue-500/10 border border-blue-500/20 rounded-2xl hover:bg-blue-500/20 transition-all group\"\n                    >\n                      <Volume2 size={20} className=\"text-blue-400 group-hover:scale-110 transition-transform\" />\n                      <span className=\"text-[10px] font-bold text-white uppercase tracking-widest\">Join Live</span>\n                    </button>\n                  </div>\n\n                  <div className=\"flex flex-col gap-3 w-full\">\n                    <div className=\"flex justify-between items-center text-[10px] text-slate-500 font-mono tracking-widest px-1\">\n                      <span>INPUT_VEC</span>\n                      <div className=\"flex items-center gap-2\">\n                        <button \n                          onClick={saveCurrentPair}\n                          className={`p-1.5 rounded-lg border transition-all ${\n                            profile.savedPairs.some(p => p.sourceCode === sourceLang.code && p.targetCode === targetLang.code)\n                            ? \"bg-orange-500/20 border-orange-500/30 text-orange-400\"\n                            : \"bg-white/5 border-white/10 text-slate-500 hover:text-orange-400\"\n                          }`}\n                        >\n                          <Star size={14} fill={profile.savedPairs.some(p => p.sourceCode === sourceLang.code && p.targetCode === targetLang.code) ? \"currentColor\" : \"none\"} />\n                        </button>\n                        <ArrowRightLeft size={12} className=\"text-blue-500/50\" />\n                      </div>\n                      <span>OUTPUT_VEC</span>\n                    </div>\n                    <div className=\"p-4 bg-white/5 border border-white/5 rounded-xl flex items-center justify-between group hover:border-blue-500/20 transition-colors\">\n                      <span className=\"text-xs font-medium text-slate-400\">Processing Latency</span>\n                      <span className=\"text-xs text-green-400 font-mono\">{isTranslating ? \'...\' : \'142ms\'}</span>\n                    </div>\n                  </div>\n\n                  <button \n                    onClick={handleTranslate}\n                    className=\"w-full px-8 py-4 bg-blue-600 hover:bg-blue-500 text-white rounded-xl font-bold text-xs uppercase tracking-widest shadow-lg shadow-blue-900/20 transition-all flex items-center justify-center gap-2\"\n                  >\n                    {isTranslating ? <RotateCw size={14} className=\"animate-spin\" /> : <RotateCw size={14} />}\n                    Process Bridge\n                  </button>\n                </div>\n              ) : ("
        replacement_content: "              {!isLive ? (\n                <div className=\"z-10 w-full space-y-8\">\n                  <div className=\"bg-slate-900/60 border border-white/10 p-10 rounded-[40px] backdrop-blur-2xl shadow-2xl relative overflow-hidden group\">\n                    <div className=\"absolute inset-0 bg-gradient-to-br from-orange-500/5 via-transparent to-green-500/5 opacity-50\"></div>\n                    <div className=\"relative z-10 text-center space-y-8\">\n                      <div>\n                        <h2 className=\"text-3xl font-black text-white tracking-tight mb-2\">Bharat Bridge</h2>\n                        <p className=\"text-[10px] text-slate-500 uppercase tracking-[0.4em] font-bold\">Bridging 1.4 Billion Voices</p>\n                      </div>\n\n                      <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n                        <button \n                          onClick={startLiveSession}\n                          className=\"flex flex-col items-center gap-4 p-8 bg-gradient-to-b from-orange-500/20 to-orange-500/5 border border-orange-500/30 rounded-3xl hover:border-orange-500/60 transition-all hover:scale-[1.02] group\"\n                        >\n                          <div className=\"w-16 h-16 rounded-2xl bg-orange-500/20 flex items-center justify-center text-orange-400 group-hover:bg-orange-500 group-hover:text-white transition-all shadow-lg\">\n                            <Mic size={32} />\n                          </div>\n                          <div className=\"text-center\">\n                            <span className=\"block text-sm font-bold text-white mb-1\">Host Event</span>\n                            <span className=\"block text-[9px] text-slate-500 uppercase tracking-widest\">Speaker Mode</span>\n                          </div>\n                        </button>\n\n                        <button \n                          onClick={() => {\n                            const id = prompt(\"Enter Event/Session ID:\");\n                            if (id) joinLiveSession(id);\n                          }}\n                          className=\"flex flex-col items-center gap-4 p-8 bg-gradient-to-b from-blue-500/20 to-blue-500/5 border border-blue-500/30 rounded-3xl hover:border-blue-500/60 transition-all hover:scale-[1.02] group\"\n                        >\n                          <div className=\"w-16 h-16 rounded-2xl bg-blue-500/20 flex items-center justify-center text-blue-400 group-hover:bg-blue-500 group-hover:text-white transition-all shadow-lg\">\n                            <Volume2 size={32} />\n                          </div>\n                          <div className=\"text-center\">\n                            <span className=\"block text-sm font-bold text-white mb-1\">Join Event</span>\n                            <span className=\"block text-[9px] text-slate-500 uppercase tracking-widest\">Listener Mode</span>\n                          </div>\n                        </button>\n                      </div>\n\n                      <div className=\"pt-4 border-t border-white/5\">\n                         <div className=\"flex items-center justify-center gap-8\">\n                            <div className=\"text-center\">\n                               <p className=\"text-[10px] text-slate-600 uppercase mb-1\">Source</p>\n                               <button onClick={() => setModalOpen({open: true, type: \'source\'})} className=\"text-xs font-bold text-orange-400 hover:text-orange-300 transition-colors\">{sourceLang.nativeName}</button>\n                            </div>\n                            <ArrowRightLeft size={14} className=\"text-slate-800\" />\n                            <div className=\"text-center\">\n                               <p className=\"text-[10px] text-slate-600 uppercase mb-1\">Your Language</p>\n                               <button onClick={() => setModalOpen({open: true, type: \'target\'})} className=\"text-xs font-bold text-blue-400 hover:text-blue-300 transition-colors\">{targetLang.nativeName}</button>\n                            </div>\n                         </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              ) : ("
      }
