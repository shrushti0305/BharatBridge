    replacement_infos {
      original_chunk {
        target_content: "        const session = sessions.get(sessionId)!;\n        if (isSpeaker) {\n          session.speaker = ws;\n          \n          // Connect to Gemini Live for speaker\n          const voiceName = gender === \'female\' ? \'Zephyr\' : \'Fenrir\';\n          \n          try {\n            session.geminiSession = await ai.live.connect({\n              model: \"gemini-2.0-flash-exp\",\n              config: {\n                systemInstruction: `You are a real-time translator. Translate everything you hear from the user into ${targetLang || \'Hindi\'}. Speak ONLY the translation. Provide high-quality audio and transcriptions.`,\n                generationConfig: {\n                  speechConfig: {\n                    voiceConfig: {\n                      prebuiltVoiceConfig: {\n                        voiceName: voiceName\n                      }\n                    }\n                  }\n                },\n                responseModalities: [Modality.AUDIO],\n              },\n              callbacks: {\n                onmessage: (msg: LiveServerMessage) => {\n                  const audio = msg.serverContent?.modelTurn?.parts?.[0]?.inlineData?.data;\n                  \n                  if (audio) {\n                    const payload = JSON.stringify({ type: \"audio\", audio });\n                    if (session.speaker?.readyState === WebSocket.OPEN) {\n                      session.speaker.send(payload);\n                    }\n                    \n                    for (const listener of session.listeners) {\n                      if (listener.readyState === WebSocket.OPEN) {\n                        try { listener.send(payload); } catch (e) { session.listeners.delete(listener); }\n                      } else {\n                        session.listeners.delete(listener);\n                      }\n                    }\n                  }\n\n                  const transcription = msg.serverContent?.modelTurn?.parts?.[0]?.text;\n                  \n                  if (transcription) {\n                    const payload = JSON.stringify({ \n                      type: \"transcription\", \n                      originalText: transcription,\n                      translatedText: transcription,\n                      isFinal: true\n                    });\n                    \n                    if (session.speaker?.readyState === WebSocket.OPEN) {\n                      session.speaker.send(payload);\n                    }\n\n                    for (const listener of session.listeners) {\n                      if (listener.readyState === WebSocket.OPEN) {\n                        try { listener.send(payload); } catch (e) { session.listeners.delete(listener); }\n                      }\n                    }\n                  }\n                  \n                  if (msg.serverContent?.interrupted) {\n                    const payload = JSON.stringify({ type: \"interrupted\" });\n                    if (session.speaker?.readyState === WebSocket.OPEN) session.speaker.send(payload);\n                    for (const listener of session.listeners) {\n                      if (listener.readyState === WebSocket.OPEN) listener.send(payload);\n                    }\n                  }\n                }\n              }\n            });\n          } catch (err) {\n            console.error(\"Gemini Live Connection Error:\", err);\n          }\n        } else {\n          session.listeners.add(ws);\n        }\n      }"
        replacement_content: "        const session = sessions.get(sessionId)!;\n        if (isSpeaker) {\n          session.speaker = ws;\n          \n          // Connect to Gemini Live for speaker\n          const voiceName = gender === \'female\' ? \'Zephyr\' : \'Fenrir\';\n          \n          try {\n            session.geminiSession = await ai.live.connect({\n              model: \"gemini-2.0-flash-exp\",\n              config: {\n                systemInstruction: `You are a real-time translator. Translate everything you hear from the user into ${targetLang || \'Hindi\'}. Speak ONLY the translation. Provide high-quality audio and transcriptions.`,\n                generationConfig: {\n                  speechConfig: {\n                    voiceConfig: {\n                      prebuiltVoiceConfig: {\n                        voiceName: voiceName\n                      }\n                    }\n                  }\n                },\n                responseModalities: [Modality.AUDIO],\n              },\n              callbacks: {\n                onmessage: (msg: LiveServerMessage) => {\n                  const audio = msg.serverContent?.modelTurn?.parts?.[0]?.inlineData?.data;\n                  \n                  if (audio) {\n                    const payload = JSON.stringify({ type: \"audio\", audio });\n                    if (session.speaker?.readyState === WebSocket.OPEN) {\n                      session.speaker.send(payload);\n                    }\n                    \n                    for (const listener of session.listeners) {\n                      if (listener.readyState === WebSocket.OPEN) {\n                        try { listener.send(payload); } catch (e) { session.listeners.delete(listener); }\n                      } else {\n                        session.listeners.delete(listener);\n                      }\n                    }\n                  }\n\n                  const transcription = msg.serverContent?.modelTurn?.parts?.[0]?.text;\n                  \n                  if (transcription) {\n                    const payload = JSON.stringify({ \n                      type: \"transcription\", \n                      originalText: transcription,\n                      translatedText: transcription,\n                      isFinal: true\n                    });\n                    \n                    if (session.speaker?.readyState === WebSocket.OPEN) {\n                      session.speaker.send(payload);\n                    }\n\n                    for (const listener of session.listeners) {\n                      if (listener.readyState === WebSocket.OPEN) {\n                        try { listener.send(payload); } catch (e) { session.listeners.delete(listener); }\n                      }\n                    }\n                  }\n                  \n                  if (msg.serverContent?.interrupted) {\n                    const payload = JSON.stringify({ type: \"interrupted\" });\n                    if (session.speaker?.readyState === WebSocket.OPEN) session.speaker.send(payload);\n                    for (const listener of session.listeners) {\n                      if (listener.readyState === WebSocket.OPEN) listener.send(payload);\n                    }\n                  }\n                }\n              }\n            });\n          } catch (err) {\n            console.error(\"Gemini Live Connection Error:\", err);\n          }\n        } else {\n          session.listeners.add(ws);\n        }\n\n        // Send current listener count\n        const countPayload = JSON.stringify({ type: \"stats\", listeners: session.listeners.size });\n        if (session.speaker?.readyState === WebSocket.OPEN) session.speaker.send(countPayload);\n        session.listeners.forEach(l => {\n          if (l.readyState === WebSocket.OPEN) l.send(countPayload);\n        });\n      }"
      }
