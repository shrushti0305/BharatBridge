      target_content: "        {/* Center Column: Bridge */}\n        <section className=\"lg:col-span-4 flex flex-col gap-4\">\n          <div className=\"bg-[#0A0F1A] border border-blue-500/20 rounded-2xl p-6 flex-1 flex flex-col shadow-[inset_0_0_30px_rgba(59,130,246,0.05)]\">\n            <h2 className=\"text-[11px] font-bold text-blue-400 uppercase tracking-widest mb-6 text-center\">Neural Translation Bridge</h2>\n            \n            <div className=\"flex flex-col gap-6 items-center flex-1 justify-center relative\">\n              <div className=\"w-full h-px bg-gradient-to-r from-transparent via-blue-500/30 to-transparent absolute top-1/2\"></div>\n              \n              <div className=\"z-10 bg-slate-900/80 border border-blue-500/30 p-5 rounded-2xl w-full text-center backdrop-blur-md\">\n                <p className=\"text-[10px] text-blue-300 uppercase mb-4 tracking-widest\">Processing Matrix</p>\n                <div className=\"grid grid-cols-4 gap-2 opacity-60\">\n                  {Array.from({ length: 8 }).map((_, i) => (\n                    <motion.div \n                      key={i}\n                      animate={isTranslating ? { opacity: [0.2, 1, 0.2] } : { opacity: 0.2 }}\n                      transition={{ repeat: Infinity, duration: 1, delay: i * 0.1 }}\n                      className=\"h-3 bg-blue-500/40 rounded-sm\"\n                    />\n                  ))}\n                </div>\n              </div>\n\n              <div className=\"flex flex-col gap-3 w-full\">\n                <div className=\"flex justify-between items-center text-[10px] text-slate-500 font-mono tracking-widest px-1\">\n                  <span>INPUT_VEC</span>\n                  <div className=\"flex items-center gap-2\">\n                    <button \n                      onClick={saveCurrentPair}\n                      className={`p-1.5 rounded-lg border transition-all ${\n                        profile.savedPairs.some(p => p.sourceCode === sourceLang.code && p.targetCode === targetLang.code)\n                        ? \"bg-orange-500/20 border-orange-500/30 text-orange-400\"\n                        : \"bg-white/5 border-white/10 text-slate-500 hover:text-orange-400\"\n                      }`}\n                    >\n                      <Star size={14} fill={profile.savedPairs.some(p => p.sourceCode === sourceLang.code && p.targetCode === targetLang.code) ? \"currentColor\" : \"none\"} />\n                    </button>\n                    <ArrowRightLeft size={12} className=\"text-blue-500/50\" />\n                  </div>\n                  <span>OUTPUT_VEC</span>\n                </div>\n                \n                <div className=\"p-4 bg-white/5 border border-white/5 rounded-xl flex items-center justify-between group hover:border-blue-500/20 transition-colors\">\n                  <span className=\"text-xs font-medium text-slate-400\">Processing Latency</span>\n                  <span className=\"text-xs text-green-400 font-mono\">{isTranslating ? \'...\' : \'142ms\'}</span>\n                </div>\n                \n                <div className=\"p-4 bg-white/5 border border-white/5 rounded-xl flex items-center justify-between group hover:border-blue-500/20 transition-colors\">\n                  <span className=\"text-xs font-medium text-slate-400\">Neural Model</span>\n                  <span className=\"text-xs text-blue-400 font-mono\">BHARAT-v4.2</span>\n                </div>\n              </div>\n\n              <button \n                onClick={handleTranslate}\n                className=\"mt-4 px-8 py-3 bg-blue-600 hover:bg-blue-500 text-white rounded-xl font-bold text-xs uppercase tracking-widest shadow-lg shadow-blue-900/20 transition-all flex items-center gap-2\"\n              >\n                {isTranslating ? <RotateCw size={14} className=\"animate-spin\" /> : <RotateCw size={14} />}\n                Rerender Bridge\n              </button>\n            </div>\n          </div>\n"
      replacement_content: "        {/* Center Column: Bridge */}\n        <section className=\"lg:col-span-4 flex flex-col gap-4\">\n          <div className=\"bg-[#0A0F1A] border border-blue-500/20 rounded-2xl p-6 flex-1 flex flex-col shadow-[inset_0_0_30px_rgba(59,130,246,0.05)]\">\n            <div className=\"flex items-center justify-between mb-6\">\n              <h2 className=\"text-[11px] font-bold text-blue-400 uppercase tracking-widest text-center flex-1\">Neural Translation Bridge</h2>\n              {isLive && (\n                <div className=\"flex items-center gap-2 px-2 py-1 bg-red-500/10 border border-red-500/20 rounded-full\">\n                  <div className=\"w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse\"></div>\n                  <span className=\"text-[9px] font-bold text-red-400 uppercase\">Live</span>\n                </div>\n              )}\n            </div>\n            \n            <div className=\"flex flex-col gap-6 items-center flex-1 justify-center relative\">\n              <div className=\"w-full h-px bg-gradient-to-r from-transparent via-blue-500/30 to-transparent absolute top-1/2\"></div>\n              \n              {!isLive ? (\n                <div className=\"z-10 w-full space-y-6\">\n                  <div className=\"bg-slate-900/80 border border-blue-500/30 p-5 rounded-2xl w-full text-center backdrop-blur-md\">\n                    <p className=\"text-[10px] text-blue-300 uppercase mb-4 tracking-widest\">Processing Matrix</p>\n                    <div className=\"grid grid-cols-4 gap-2 opacity-60\">\n                      {Array.from({ length: 8 }).map((_, i) => (\n                        <motion.div \n                          key={i}\n                          animate={isTranslating ? { opacity: [0.2, 1, 0.2] } : { opacity: 0.2 }}\n                          transition={{ repeat: Infinity, duration: 1, delay: i * 0.1 }}\n                          className=\"h-3 bg-blue-500/40 rounded-sm\"\n                        />\n                      ))}\n                    </div>\n                  </div>\n\n                  <div className=\"grid grid-cols-2 gap-3\">\n                    <button \n                      onClick={startLiveSession}\n                      className=\"flex flex-col items-center justify-center gap-2 p-4 bg-orange-500/10 border border-orange-500/20 rounded-2xl hover:bg-orange-500/20 transition-all group\"\n                    >\n                      <Mic size={20} className=\"text-orange-400 group-hover:scale-110 transition-transform\" />\n                      <span className=\"text-[10px] font-bold text-white uppercase tracking-widest\">Go Live</span>\n                    </button>\n                    <button \n                      onClick={() => {\n                        const id = prompt(\"Enter Session ID:\");\n                        if (id) joinLiveSession(id);\n                      }}\n                      className=\"flex flex-col items-center justify-center gap-2 p-4 bg-blue-500/10 border border-blue-500/20 rounded-2xl hover:bg-blue-500/20 transition-all group\"\n                    >\n                      <Volume2 size={20} className=\"text-blue-400 group-hover:scale-110 transition-transform\" />\n                      <span className=\"text-[10px] font-bold text-white uppercase tracking-widest\">Join Live</span>\n                    </button>\n                  </div>\n\n                  <div className=\"flex flex-col gap-3 w-full\">\n                    <div className=\"flex justify-between items-center text-[10px] text-slate-500 font-mono tracking-widest px-1\">\n                      <span>INPUT_VEC</span>\n                      <div className=\"flex items-center gap-2\">\n                        <button \n                          onClick={saveCurrentPair}\n                          className={`p-1.5 rounded-lg border transition-all ${\n                            profile.savedPairs.some(p => p.sourceCode === sourceLang.code && p.targetCode === targetLang.code)\n                            ? \"bg-orange-500/20 border-orange-500/30 text-orange-400\"\n                            : \"bg-white/5 border-white/10 text-slate-500 hover:text-orange-400\"\n                          }`}\n                        >\n                          <Star size={14} fill={profile.savedPairs.some(p => p.sourceCode === sourceLang.code && p.targetCode === targetLang.code) ? \"currentColor\" : \"none\"} />\n                        </button>\n                        <ArrowRightLeft size={12} className=\"text-blue-500/50\" />\n                      </div>\n                      <span>OUTPUT_VEC</span>\n                    </div>\n                    <div className=\"p-4 bg-white/5 border border-white/5 rounded-xl flex items-center justify-between group hover:border-blue-500/20 transition-colors\">\n                      <span className=\"text-xs font-medium text-slate-400\">Processing Latency</span>\n                      <span className=\"text-xs text-green-400 font-mono\">{isTranslating ? \'...\' : \'142ms\'}</span>\n                    </div>\n                  </div>\n\n                  <button \n                    onClick={handleTranslate}\n                    className=\"w-full px-8 py-4 bg-blue-600 hover:bg-blue-500 text-white rounded-xl font-bold text-xs uppercase tracking-widest shadow-lg shadow-blue-900/20 transition-all flex items-center justify-center gap-2\"\n                  >\n                    {isTranslating ? <RotateCw size={14} className=\"animate-spin\" /> : <RotateCw size={14} />}\n                    Process Bridge\n                  </button>\n                </div>\n              ) : (\n                <div className=\"z-10 w-full space-y-4\">\n                  <div className=\"flex items-center justify-between px-1\">\n                    <div className=\"flex flex-col\">\n                      <span className=\"text-[10px] text-slate-500 uppercase\">Role: {sessionRole}</span>\n                      <button \n                        onClick={() => {\n                          navigator.clipboard.writeText(currentSession?.id || \"\");\n                          alert(\"Copied Session ID\");\n                        }}\n                        className=\"text-[10px] font-mono text-blue-400 hover:text-blue-300\"\n                      >\n                        ID: {currentSession?.id.slice(0, 8)}...\n                      </button>\n                    </div>\n                    <button \n                      onClick={endLiveSession}\n                      className=\"text-[10px] font-bold text-red-400 uppercase hover:text-red-300\"\n                    >\n                      End Session\n                    </button>\n                  </div>\n\n                  <div className=\"h-[300px] overflow-y-auto space-y-3 pr-2 scrollbar-thin\">\n                    {messages.length === 0 ? (\n                      <div className=\"h-full flex flex-col items-center justify-center opacity-40\">\n                        <RotateCw size={24} className=\"animate-spin text-blue-500 mb-2\" />\n                        <p className=\"text-[10px] text-slate-500 uppercase tracking-widest\">Awaiting Transmission...</p>\n                      </div>\n                    ) : (\n                      messages.map((msg) => (\n                        <motion.div \n                          initial={{ opacity: 0, x: -10 }}\n                          animate={{ opacity: 1, x: 0 }}\n                          key={msg.id} \n                          className=\"p-3 bg-white/5 border border-white/5 rounded-xl space-y-1\"\n                        >\n                          <p className=\"text-[10px] text-slate-500 italic\">\"{msg.text}\"</p>\n                          <p className=\"text-sm font-semibold text-white\">{msg.translatedText}</p>\n                        </motion.div>\n                      ))\n                    )}\n                  </div>\n\n                  {sessionRole === \'speaker\' && (\n                    <button \n                      onClick={toggleListening}\n                      className={`w-full py-4 rounded-xl flex items-center justify-center gap-3 font-bold uppercase tracking-widest transition-all ${\n                        isListening \n                        ? \'bg-red-500 text-white shadow-[0_0_30px_rgba(239,68,68,0.3)]\' \n                        : \'bg-orange-500 text-white shadow-[0_0_30px_rgba(249,115,22,0.3)]\'\n                      }`}\n                    >\n                      {isListening ? <MicOff size={16} /> : <Mic size={16} />}\n                      {isListening ? \'Stop\' : \'Broadcast\'}\n                    </button>\n                  )}\n                </div>\n              )}\n            </div>\n          </div>\n"
