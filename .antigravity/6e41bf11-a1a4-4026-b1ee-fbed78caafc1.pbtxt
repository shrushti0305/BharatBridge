        }
        lines {
          text: "    if (voice) utterance.voice = voice;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    utterance.lang = lang.code === \"en\" ? \"en-IN\" : `${lang.code}-IN`;"
