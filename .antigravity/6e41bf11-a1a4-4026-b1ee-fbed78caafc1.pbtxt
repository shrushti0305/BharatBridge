      replacement_content: "import { LanguageConfig } from \"./types\";\n\nexport const LANGUAGES: LanguageConfig[] = [\n  {\n    code: \"hi\",\n    name: \"Hindi\",\n    nativeName: \"\340\244\271\340\244\277\340\244\250\340\245\215\340\244\246\340\245\200\",\n    script: \"Devanagari\",\n    direction: \"ltr\",\n    sttSupported: true,\n    translationSupported: true,\n    ttsSupported: true,\n    enabled: true,\n  },\n  {\n    code: \"bn\",\n    name: \"Bengali\",\n    nativeName: \"\340\246\254\340\246\276\340\246\202\340\246\262\340\246\276\",\n    script: \"Bengali\",\n    direction: \"ltr\",\n    sttSupported: true,\n    translationSupported: true,\n    ttsSupported: true,\n    enabled: true,\n  },\n  {\n    code: \"mr\",\n    name: \"Marathi\",\n    nativeName: \"\340\244\256\340\244\260\340\244\276\340\244\240\340\245\200\",\n    script: \"Devanagari\",\n    direction: \"ltr\",\n    sttSupported: true,\n    translationSupported: true,\n    ttsSupported: true,\n    enabled: true,\n  },\n  {\n    code: \"te\",\n    name: \"Telugu\",\n    nativeName: \"\340\260\244\340\261\206\340\260\262\340\261\201\340\260\227\340\261\201\",\n    script: \"Telugu\",\n    direction: \"ltr\",\n    sttSupported: true,\n    translationSupported: true,\n    ttsSupported: true,\n    enabled: true,\n  },\n  {\n    code: \"ta\",\n    name: \"Tamil\",\n    nativeName: \"\340\256\244\340\256\256\340\256\277\340\256\264\340\257\215\",\n    script: \"Tamil\",\n    direction: \"ltr\",\n    sttSupported: true,\n    translationSupported: true,\n    ttsSupported: true,\n    enabled: true,\n  },\n  {\n    code: \"gu\",\n    name: \"Gujarati\",\n    nativeName: \"\340\252\227\340\253\201\340\252\234\340\252\260\340\252\276\340\252\244\340\253\200\",\n    script: \"Gujarati\",\n    direction: \"ltr\",\n    sttSupported: true,\n    translationSupported: true,\n    ttsSupported: true,\n    enabled: true,\n  },\n  {\n    code: \"ur\",\n    name: \"Urdu\",\n    nativeName: \"\330\247\330\261\330\2