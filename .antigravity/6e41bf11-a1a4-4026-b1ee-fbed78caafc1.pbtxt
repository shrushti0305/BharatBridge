          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <ProfileModal "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            isOpen={modalOpen.open}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
