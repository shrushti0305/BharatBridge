      original_chunk {
        target_content: "  const recognitionRef = useRef<any>(null);\n  const ttsRef = useRef<SpeechSynthesisUtterance | null>(null);\n\n  // Initialize Speech Recognition\n  useEffect(() => {\n    const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;\n    if (SpeechRecognition) {\n      recognitionRef.current = new SpeechRecognition();\n      recognitionRef.current.continuous = true;\n      recognitionRef.current.interimResults = true;\n\n      recognitionRef.current.onresult = (event: any) => {\n        let transcript = \"\";\n        for (let i = event.resultIndex; i < event.results.length; i++) {\n          transcript += event.results[i][0].transcript;\n        }\n        setInputText(transcript);\n      };\n\n      recognitionRef.current.onerror = (event: any) => {\n        console.error(\"Speech recognition error\", event.error);\n        setIsListening(false);\n      };\n\n      recognitionRef.current.onend = () => {\n        setIsListening(false);\n      };\n    }\n  }, []);\n\n  // Update recognition language\n  useEffect(() => {\n    if (recognitionRef.current) {\n      recognitionRef.current.lang = sourceLang.code === \"en\" ? \"en-IN\" : `${sourceLang.code}-IN`;\n    }\n  }, [sourceLang]);\n\n  const toggleListening = () => {\n    if (isListening) {\n      recognitionRef.current?.stop();\n    } else {\n      setInputText(\"\");\n      recognitionRef.current?.start();\n      setIsListening(true);\n    }\n  };\n\n  const handleTranslate = async () => {\n    if (!inputText.trim()) return;\n    \n    setIsTranslating(true);\n    try {\n      const res = await fetch(\"/api/translate\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          text: inputText,\n          sourceLanguage: autoDetect ? undefined : sourceLang.name,\n          targetLanguage: targetLang.name\n        })\n      });\n      const data = await res.json();\n      setTranslatedText(data.translatedText);\n      \n      // Auto-detect update if needed\n      if (autoDetect && data.detectedLanguage) {\n        // We could update sourceLang here if the server returns a code\n      }\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setIsTranslating(false);\n    }\n  };\n\n  // Debounced translation\n  useEffect(() => {\n    const timer = setTimeout(() => {\n      if (inputText && !isListening) {\n        handleTranslate();\n      }\n    }, 1000);\n    return () => clearTimeout(timer);\n  }, [inputText, targetLang]);\n\n  const speak = (text: string, lang: LanguageConfig) => {\n    if (!text) return;\n    window.speechSynthesis.cancel();\n    \n    const utterance = new SpeechSynthesisUtterance(text);\n    // Find a matching voice\n    const voices = window.speechSynthesis.getVoices();\n    const voice = voices.find(v => v.lang.startsWith(lang.code)) || voices.find(v => v.lang.includes(\"IN\"));\n    if (voice) utterance.voice = voice;\n    utterance.lang = lang.code === \"en\" ? \"en-IN\" : `${lang.code}-IN`;\n    \n    window.speechSynthesis.speak(utterance);\n  };\n\n  const swapLanguages = () => {\n    setSourceLang(targetLang);\n    setTargetLang(sourceLang);\n    setInputText(translatedText);\n    setTranslatedText(inputText);\n  };\n\n  const copyToClipboard = (text: string) => {\n    navigator.clipboard.writeText(text);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-neutral-50 text-neutral-900 font-sans selection:bg-orange-100\">\n      {/* Header */}\n      <header className=\"bg-white border-b sticky top-0 z-40\">\n        <div className=\"max-w-5xl mx-auto px-4 h-16 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 bg-orange-500 rounded-xl flex items-center justify-center text-white shadow-lg shadow-orange-200\">\n              <ArrowRightLeft size={22} />\n            </div>\n            <div>\n              <h1 className=\"font-bold text-xl tracking-tight text-neutral-800\">Bharat Bridge</h1>\n              <p className=\"text-[10px] uppercase tracking-widest font-bold text-orange-500 -mt-1\">Linguistic Gateway</p>\n            </div>\n          </div>\n          <button className=\"p-2 hover:bg-neutral-100 rounded-full transition-colors\">\n            <Globe size={20} className=\"text-neutral-500\" />\n          </button>\n        </div>\n      </header>\n\n      <main className=\"max-w-5xl mx-auto px-4 py-8 md:py-12\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6 items-start\">\n          \n          {/* Controls - Language Selection */}\n          <div className=\"lg:col-span-2 flex flex-col md:flex-row items-center gap-2 md:gap-4 mb-4\">\n            <button \n              onClick={() => setModalOpen({ open: true, type: \"source\" })}\n              className=\"w-full md:w-auto flex-1 bg-white border border-neutral-200 p-4 rounded-2xl flex items-center justify-between hover:border-orange-300 hover:shadow-sm transition-all group\"\n            >\n              <div className=\"flex flex-col items-start\">\n                <span className=\"text-[10px] font-bold text-neutral-400 uppercase tracking-wider\">From</span>\n                <span className=\"font-semibold text-lg flex items-center gap-2\">\n                  {autoDetect ? \"Auto Detect\" : sourceLang.nativeName}\n                  <ChevronDown size={16} className=\"text-neutral-400 group-hover:text-orange-500 transition-colors\" />\n                </span>\n              </div>\n              {!autoDetect && <span className=\"text-sm text-neutral-400 font-medium\">{sourceLang.name}</span>}\n            </button>\n\n            <button \n              onClick={swapLanguages}\n              className=\"p-3 bg-white border border-neutral-200 rounded-full hover:bg-neutral-50 hover:border-orange-300 hover:rotate-180 transition-all duration-500 text-neutral-400 hover:text-orange-500 shadow-sm\"\n            >\n              <ArrowRightLeft size={20} />\n            </button>\n\n            <button \n              onClick={() => setModalOpen({ open: true, type: \"target\" })}\n              className=\"w-full md:w-auto flex-1 bg-white border border-neutral-200 p-4 rounded-2xl flex items-center justify-between hover:border-orange-300 hover:shadow-sm transition-all group\"\n            >\n              <div className=\"flex flex-col items-start\">\n                <span className=\"text-[10px] font-bold text-neutral-400 uppercase tracking-wider\">To</span>\n                <span className=\"font-semibold text-lg flex items-center gap-2\">\n                  {targetLang.nativeName}\n                  <ChevronDown size={16} className=\"text-neutral-400 group-hover:text-orange-500 transition-colors\" />\n                </span>\n              </div>\n              <span className=\"text-sm text-neutral-400 font-medium\">{targetLang.name}</span>\n            </button>\n          </div>\n\n          {/* Input Panel */}\n          <motion.div \n            initial={{ opacity: 0, y: 10 }}\n            animate={{ opacity: 1, y: 0 }}\n            className=\"bg-white border border-neutral-200 rounded-3xl overflow-hidden shadow-sm flex flex-col h-[400px] group focus-within:border-orange-300 transition-all\"\n          >\n            <div className=\"p-4 border-b flex items-center justify-between bg-neutral-50/50\">\n              <div className=\"flex items-center gap-2\">\n                <Languages size={16} className=\"text-orange-500\" />\n                <span className=\"text-xs font-bold text-neutral-400 uppercase tracking-widest\">{sourceLang.name}</span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <label className=\"flex items-center gap-2 cursor-pointer\">\n                  <input \n                    type=\"checkbox\" \n                    checked={autoDetect} \n                    onChange={(e) => setAutoDetect(e.target.checked)}\n                    className=\"w-4 h-4 rounded text-orange-500 focus:ring-orange-500 border-neutral-300\"\n                  />\n                  <span className=\"text-xs font-medium text-neutral-500\">Auto Detect</span>\n                </label>\n              </div>\n            </div>\n            <textarea\n              dir={sourceLang.direction}\n              value={inputText}\n              onChange={(e) => setInputText(e.target.value)}\n              placeholder={`Speak or type in ${sourceLang.name}...`}\n              className=\"flex-1 p-6 text-xl bg-transparent border-none outline-none resize-none placeholder:text-neutral-300 leading-relaxed font-medium\"\n            />\n            <div className=\"p-4 bg-neutral-50/30 flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <button \n                  onClick={toggleListening}\n                  className={`p-3 rounded-full transition-all ${\n                    isListening \n                    ? \"bg-red-500 text-white animate-pulse\" \n                    : \"bg-orange-100 text-orange-600 hover:bg-orange-200\"\n                  }`}\n                >\n                  {isListening ? <MicOff size={20} /> : <Mic size={20} />}\n                </button>\n                <button \n                  onClick={() => speak(inputText, sourceLang)}\n                  disabled={!inputText}\n                  className=\"p-3 text-neutral-400 hover:text-neutral-600 disabled:opacity-30 rounded-full transition-colors\"\n                >\n                  <Volume2 size={20} />\n                </button>\n              </div>\n              <div className=\"text-xs text-neutral-400 font-medium\">\n                {inputText.length} characters\n              </div>\n            </div>\n          </motion.div>\n\n          {/* Output Panel */}\n          <motion.div \n            initial={{ opacity: 0, y: 10 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ delay: 0.1 }}\n            className=\"bg-white border border-neutral-200 rounded-3xl overflow-hidden shadow-sm flex flex-col h-[400px]\"\n          >\n            <div className=\"p-4 border-b flex items-center justify-between bg-neutral-50/50\">\n              <div className=\"flex items-center gap-2\">\n                <Globe size={16} className=\"text-orange-500\" />\n                <span className=\"text-xs font-bold text-neutral-400 uppercase tracking-widest\">{targetLang.name}</span>\n              </div>\n              {isTranslating && (\n                <div className=\"flex items-center gap-2\">\n                  <RotateCw size={14} className=\"animate-spin text-orange-500\" />\n                  <span className=\"text-[10px] font-bold text-orange-500 uppercase tracking-widest\">Translating</span>\n                </div>\n              )}\n            </div>\n            <div \n              dir={targetLang.direction}\n              className={`flex-1 p-6 text-xl leading-relaxed overflow-y-auto font-medium ${!translatedText ? \'text-neutral-300\' : \'text-neutral-800\'}`}\n            >\n              {translatedText || `Translation in ${targetLang.name} will appear here...`}\n            </div>\n            <div className=\"p-4 bg-neutral-50/30 flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <button \n                  onClick={() => speak(translatedText, targetLang)}\n                  disabled={!translatedText}\n                  className=\"p-3 bg-orange-100 text-orange-600 hover:bg-orange-200 disabled:opacity-30 rounded-full transition-all\"\n                >\n                  <Volume2 size={20} />\n                </button>\n                <button \n                  onClick={() => copyToClipboard(translatedText)}\n                  disabled={!translatedText}\n                  className=\"p-3 text-neutral-400 hover:text-neutral-600 disabled:opacity-30 rounded-full transition-colors relative\"\n                >\n                  {copied ? <Check size={20} className=\"text-green-500\" /> : <Copy size={20} />}\n                </button>\n              </div>\n              <div className=\"flex items-center gap-1 px-3 py-1 bg-neutral-100 rounded-full\">\n                <div className={`w-1.5 h-1.5 rounded-full ${translatedText ? \'bg-green-500\' : \'bg-neutral-300\'}`} />\n                <span className=\"text-[10px] font-bold text-neutral-400 uppercase tracking-widest\">Real-time</span>\n              </div>\n            </div>\n          </motion.div>\n\n          {/* Features / Capabilities */}\n          <div className=\"lg:col-span-2 grid grid-cols-2 md:grid-cols-4 gap-4 mt-8\">\n            {[\n              { label: \"High Quality\", value: \"99% Accuracy\", icon: Check },\n              { label: \"Speech-to-Speech\", value: \"Voice Enabled\", icon: Mic },\n              { label: \"22+ Languages\", value: \"Indian Scripts\", icon: Languages },\n              { label: \"RTL Support\", value: \"Urdu & Sindhi\", icon: Globe }\n            ].map((feature, i) => (\n              <div key={i} className=\"p-4 bg-white border border-neutral-200 rounded-2xl shadow-sm hover:border-orange-200 transition-colors\">\n                <div className=\"w-8 h-8 bg-orange-50 rounded-lg flex items-center justify-center text-orange-500 mb-2\">\n                  <feature.icon size={16} />\n                </div>\n                <p className=\"text-[10px] font-bold text-neutral-400 uppercase tracking-widest mb-1\">{feature.label}</p>\n                <p className=\"text-xs font-semibold text-neutral-700\">{feature.value}</p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </main>\n\n      {/* Modals */}\n      <AnimatePresence>\n        {modalOpen.open && (\n          <LanguageModal \n            isOpen={modalOpen.open} \n            title={modalOpen.type === \"source\" ? \"Source Language\" : \"Target Language\"}\n            onClose={() => setModalOpen({ open: false, type: \"source\" })}\n            selectedCode={modalOpen.type === \"source\" ? sourceLang.code : targetLang.code}\n            onSelect={(lang) => {\n              if (modalOpen.type === \"source\") setSourceLang(lang);\n              else setTargetLang(lang);\n            }}\n          />\n        )}\n      </AnimatePresence>\n\n      <footer className=\"mt-20 border-t py-12 bg-white\">\n        <div className=\"max-w-5xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-6\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 bg-neutral-800 rounded-lg flex items-center justify-center text-white\">\n              <ArrowRightLeft size={16} />\n            </div>\n            <span className=\"font-bold text-neutral-800\">Bharat Bridge</span>\n          </div>\n          <div className=\"flex items-center gap-8\">\n            <a href=\"#\" className=\"text-xs font-bold text-neutral-400 uppercase tracking-widest hover:text-neutral-900\">Privacy</a>\n            <a href=\"#\" className=\"text-xs font-bold text-neutral-400 uppercase tracking-widest hover:text-neutral-900\">Terms</a>\n            <a href=\"#\" className=\"text-xs font-bold text-neutral-400 uppercase tracking-widest hover:text-neutral-900\">About</a>\n          </div>\n          <p className=\"text-xs text-neutral-400\">\302\251 2026 Bharat Bridge. Connecting India.</p>\n        </div>\n      </footer>\n    </div>\n  );\n}"
        replacement_content: "  const recognitionRef = useRef<any>(null);\n\n  // Initialize Speech Recognition\n  useEffect(() => {\n    const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;\n    if (SpeechRecognition) {\n      recognitionRef.current = new SpeechRecognition();\n      recognitionRef.current.continuous = true;\n      recognitionRef.current.interimResults = true;\n\n      recognitionRef.current.onresult = (event: any) => {\n        let transcript = \"\";\n        for (let i = event.resultIndex; i < event.results.length; i++) {\n          transcript += event.results[i][0].transcript;\n        }\n        setInputText(transcript);\n      };\n\n      recognitionRef.current.onerror = (event: any) => {\n        console.error(\"Speech recognition error\", event.error);\n        setIsListening(false);\n      };\n\n      recognitionRef.current.onend = () => {\n        setIsListening(false);\n      };\n    }\n  }, []);\n\n  // Update recognition language\n  useEffect(() => {\n    if (recognitionRef.current) {\n      recognitionRef.current.lang = sourceLang.code === \"en\" ? \"en-IN\" : `${sourceLang.code}-IN`;\n    }\n  }, [sourceLang]);\n\n  const toggleListening = () => {\n    if (isListening) {\n      recognitionRef.current?.stop();\n    } else {\n      setInputText(\"\");\n      recognitionRef.current?.start();\n      setIsListening(true);\n    }\n  };\n\n  const handleTranslate = async () => {\n    if (!inputText.trim()) return;\n    \n    setIsTranslating(true);\n    try {\n      const res = await fetch(\"/api/translate\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          text: inputText,\n          sourceLanguage: autoDetect ? undefined : sourceLang.name,\n          targetLanguage: targetLang.name\n        })\n      });\n      const data = await res.json();\n      setTranslatedText(data.translatedText);\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setIsTranslating(false);\n    }\n  };\n\n  // Debounced translation\n  useEffect(() => {\n    const timer = setTimeout(() => {\n      if (inputText && !isListening) {\n        handleTranslate();\n      }\n    }, 1000);\n    return () => clearTimeout(timer);\n  }, [inputText, targetLang]);\n\n  const speak = (text: string, lang: LanguageConfig) => {\n    if (!text) return;\n    window.speechSynthesis.cancel();\n    \n    const utterance = new SpeechSynthesisUtterance(text);\n    const voices = window.speechSynthesis.getVoices();\n    const voice = voices.find(v => v.lang.startsWith(lang.code)) || voices.find(v => v.lang.includes(\"IN\"));\n    if (voice) utterance.voice = voice;\n    utterance.lang = lang.code === \"en\" ? \"en-IN\" : `${lang.code}-IN`;\n    \n    window.speechSynthesis.speak(utterance);\n  };\n\n  const swapLanguages = () => {\n    setSourceLang(targetLang);\n    setTargetLang(sourceLang);\n    setInputText(translatedText);\n    setTranslatedText(inputText);\n  };\n\n  const copyToClipboard = (text: string) => {\n    navigator.clipboard.writeText(text);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#020408] text-slate-200 font-sans selection:bg-orange-500/30 flex flex-col overflow-x-hidden\">\n      {/* Header */}\n      <header className=\"flex justify-between items-center py-6 px-8 border-b border-white/5 bg-black/20 backdrop-blur-md sticky top-0 z-40\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-10 h-10 bg-gradient-to-tr from-orange-500 via-white to-green-600 rounded-lg flex items-center justify-center shadow-[0_0_20px_rgba(255,165,0,0.3)]\">\n            <div className=\"w-6 h-6 border-2 border-slate-900 rounded-full flex items-center justify-center font-bold text-[10px]\">BB</div>\n          </div>\n          <div>\n            <h1 className=\"text-xl font-bold tracking-tight text-white leading-none\">BharatBridge</h1>\n            <p className=\"text-[10px] text-slate-500 uppercase tracking-widest mt-1\">Unified Indian Language Grid</p>\n          </div>\n        </div>\n        <div className=\"flex items-center gap-6\">\n          <div className=\"hidden md:flex items-center gap-2 px-3 py-1 bg-white/5 rounded-full border border-white/10\">\n            <div className={`w-2 h-2 rounded-full ${isListening ? \'bg-red-500 shadow-[0_0_8px_#ef4444]\' : \'bg-green-500 shadow-[0_0_8px_#22c55e]\'}`}></div>\n            <span className=\"text-[11px] font-medium text-slate-400 uppercase tracking-wider\">\n              STT Pipeline: {isListening ? \'Streaming\' : \'Active\'}\n            </span>\n          </div>\n          <div className=\"text-right hidden sm:block\">\n            <p className=\"text-[10px] text-slate-500 uppercase\">Server Node</p>\n            <p className=\"text-xs font-mono text-orange-400\">BHARAT-WEST-042</p>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"flex-1 max-w-[1440px] mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-6 p-6 lg:p-8 overflow-hidden\">\n        \n        {/* Left Column: Source Input */}\n        <section className=\"lg:col-span-4 flex flex-col gap-4\">\n          <div className=\"bg-white/5 border border-white/10 rounded-2xl p-5 flex-1 flex flex-col min-h-[400px]\">\n            <div className=\"flex justify-between items-center mb-4\">\n              <h2 className=\"text-[11px] font-bold text-slate-500 uppercase tracking-widest\">Source Input</h2>\n              <div className=\"flex gap-2\">\n                <button \n                  onClick={() => setAutoDetect(!autoDetect)}\n                  className={`px-2 py-1 rounded text-[10px] border transition-colors ${autoDetect ? \'bg-orange-500/20 text-orange-400 border-orange-500/30\' : \'bg-white/5 text-slate-500 border-white/10\'}`}\n                >\n                  AUTO DETECT\n                </button>\n              </div>\n            </div>\n\n            <button \n              onClick={() => setModalOpen({ open: true, type: \"source\" })}\n              className=\"flex items-center gap-4 p-4 bg-white/5 rounded-xl border border-white/5 mb-4 hover:bg-white/10 transition-colors group text-left\"\n            >\n              <div className=\"w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center text-xl shadow-inner\">\n                {sourceLang.nativeName[0]}\n              </div>\n              <div className=\"flex-1\">\n                <p className=\"text-xs text-slate-400\">From Language</p>\n                <p className=\"text-lg font-semibold text-white\">\n                  {autoDetect ? \"Auto Detect\" : sourceLang.nativeName}\n                  <span className=\"text-slate-500 font-normal ml-2 text-sm hidden sm:inline\">{autoDetect ? \"\" : sourceLang.name}</span>\n                </p>\n              </div>\n              <ChevronDown size={16} className=\"text-slate-500 group-hover:text-orange-400 transition-colors\" />\n            </button>\n\n            <div className=\"flex-1 bg-black/40 rounded-xl p-6 font-serif text-lg leading-relaxed text-slate-300 relative group\">\n              <textarea\n                dir={sourceLang.direction}\n                value={inputText}\n                onChange={(e) => setInputText(e.target.value)}\n                placeholder={`Speak or type in ${sourceLang.name}...`}\n                className=\"w-full h-full bg-transparent border-none outline-none resize-none placeholder:text-slate-700 leading-relaxed\"\n              />\n              {isListening && (\n                <div className=\"absolute top-2 right-2 flex gap-1\">\n                  <span className=\"w-1 h-3 bg-orange-500 rounded-full animate-pulse\"></span>\n                  <span className=\"w-1 h-3 bg-orange-500 rounded-full delay-75 animate-pulse\"></span>\n                  <span className=\"w-1 h-3 bg-orange-500 rounded-full delay-150 animate-pulse\"></span>\n                </div>\n              )}\n            </div>\n\n            <div className=\"mt-4 pt-4 border-t border-white/5 flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <button \n                  onClick={toggleListening}\n                  className={`p-3 rounded-xl transition-all ${isListening ? \'bg-red-500/20 text-red-400 border border-red-500/30 animate-pulse\' : \'bg-orange-500/20 text-orange-400 border border-orange-500/30 hover:bg-orange-500/30\'}`}\n                >\n                  {isListening ? <MicOff size={20} /> : <Mic size={20} />}\n                </button>\n                <button \n                  onClick={() => speak(inputText, sourceLang)}\n                  disabled={!inputText}\n                  className=\"p-3 bg-white/5 text-slate-400 border border-white/10 rounded-xl hover:bg-white/10 transition-colors disabled:opacity-20\"\n                >\n                  <Volume2 size={20} />\n                </button>\n              </div>\n              <div className=\"text-[10px] text-slate-500 uppercase font-mono tracking-tighter\">\n                {inputText.length} CHARS / {inputText.split(/\\s+/).filter(Boolean).length} WORDS\n              </div>\n            </div>\n          </div>\n\n          <div className=\"h-24 bg-white/5 border border-white/10 rounded-2xl p-4 flex items-center justify-between\">\n            <div>\n              <p className=\"text-[10px] text-slate-500 uppercase mb-1\">Audio Profile</p>\n              <div className=\"flex items-end gap-1 h-8\">\n                {[2, 4, 6, 3, 5, 7, 2, 4, 6, 3].map((h, i) => (\n                  <motion.div \n                    key={i}\n                    animate={isListening ? { height: [h*2, h*4, h*2] } : { height: h*2 }}\n                    transition={{ repeat: Infinity, duration: 0.5, delay: i * 0.05 }}\n                    className=\"w-1 bg-orange-500/60 rounded-full\"\n                  />\n                ))}\n              </div>\n            </div>\n            <div className=\"text-right\">\n              <p className=\"text-[10px] text-slate-500 uppercase\">Sampling Rate</p>\n              <p className=\"text-xs font-mono text-slate-300\">48kHz / 24-bit</p>\n            </div>\n          </div>\n        </section>\n\n        {/* Center Column: Bridge */}\n        <section className=\"lg:col-span-4 flex flex-col gap-4\">\n          <div className=\"bg-[#0A0F1A] border border-blue-500/20 rounded-2xl p-6 flex-1 flex flex-col shadow-[inset_0_0_30px_rgba(59,130,246,0.05)]\">\n            <h2 className=\"text-[11px] font-bold text-blue-400 uppercase tracking-widest mb-6 text-center\">Neural Translation Bridge</h2>\n            \n            <div className=\"flex flex-col gap-6 items-center flex-1 justify-center relative\">\n              <div className=\"w-full h-px bg-gradient-to-r from-transparent via-blue-500/30 to-transparent absolute top-1/2\"></div>\n              \n              <div className=\"z-10 bg-slate-900/80 border border-blue-500/30 p-5 rounded-2xl w-full text-center backdrop-blur-md\">\n                <p className=\"text-[10px] text-blue-300 uppercase mb-4 tracking-widest\">Processing Matrix</p>\n                <div className=\"grid grid-cols-4 gap-2 opacity-60\">\n                  {Array.from({ length: 8 }).map((_, i) => (\n                    <motion.div \n                      key={i}\n                      animate={isTranslating ? { opacity: [0.2, 1, 0.2] } : { opacity: 0.2 }}\n                      transition={{ repeat: Infinity, duration: 1, delay: i * 0.1 }}\n                      className=\"h-3 bg-blue-500/40 rounded-sm\"\n                    />\n                  ))}\n                </div>\n              </div>\n\n              <div className=\"flex flex-col gap-3 w-full\">\n                <div className=\"flex justify-between items-center text-[10px] text-slate-500 font-mono tracking-widest\">\n                  <span>INPUT_VEC</span>\n                  <ArrowRightLeft size={12} className=\"text-blue-500/50\" />\n                  <span>OUTPUT_VEC</span>\n                </div>\n                \n                <div className=\"p-4 bg-white/5 border border-white/5 rounded-xl flex items-center justify-between group hover:border-blue-500/20 transition-colors\">\n                  <span className=\"text-xs font-medium text-slate-400\">Processing Latency</span>\n                  <span className=\"text-xs text-green-400 font-mono\">{isTranslating ? \'...\' : \'142ms\'}</span>\n                </div>\n                \n                <div className=\"p-4 bg-white/5 border border-white/5 rounded-xl flex items-center justify-between group hover:border-blue-500/20 transition-colors\">\n                  <span className=\"text-xs font-medium text-slate-400\">Neural Model</span>\n                  <span className=\"text-xs text-blue-400 font-mono\">BHARAT-v4.2</span>\n                </div>\n              </div>\n\n              <button \n                onClick={handleTranslate}\n                className=\"mt-4 px-8 py-3 bg-blue-600 hover:bg-blue-500 text-white rounded-xl font-bold text-xs uppercase tracking-widest shadow-lg shadow-blue-900/20 transition-all flex items-center gap-2\"\n              >\n                {isTranslating ? <RotateCw size={14} className=\"animate-spin\" /> : <RotateCw size={14} />}\n                Rerender Bridge\n              </button>\n            </div>\n          </div>\n\n          <div className=\"bg-white/5 border border-white/10 rounded-2xl p-5\">\n            <h3 className=\"text-[11px] text-slate-500 uppercase mb-3 tracking-widest\">Target Configuration</h3>\n            <div className=\"grid grid-cols-2 gap-2\">\n              <button className=\"bg-slate-800/30 p-3 rounded-xl border border-white/5 text-center hover:bg-slate-800/50 transition-colors\">\n                <p className=\"text-[10px] text-slate-500 uppercase mb-1\">TTS Mode</p>\n                <p className=\"text-xs font-semibold text-slate-300\">High-Fidelity</p>\n              </button>\n              <button className=\"bg-slate-800/30 p-3 rounded-xl border border-white/5 text-center hover:bg-slate-800/50 transition-colors\">\n                <p className=\"text-[10px] text-slate-500 uppercase mb-1\">Context</p>\n                <p className=\"text-xs font-semibold text-slate-300\">Formal/Grid</p>\n              </button>\n            </div>\n          </div>\n        </section>\n\n        {/* Right Column: Target Output */}\n        <section className=\"lg:col-span-4 flex flex-col gap-4\">\n          <div className=\"bg-white/5 border border-white/10 rounded-2xl p-5 flex-1 flex flex-col min-h-[400px]\">\n            <div className=\"flex justify-between items-center mb-4\">\n              <h2 className=\"text-[11px] font-bold text-slate-500 uppercase tracking-widest\">Target Output</h2>\n              <button \n                onClick={() => setModalOpen({ open: true, type: \"target\" })}\n                className=\"text-[10px] text-blue-400 hover:text-blue-300 uppercase font-bold tracking-tighter transition-colors\"\n              >\n                Change Target\n              </button>\n            </div>\n\n            <button \n              onClick={() => setModalOpen({ open: true, type: \"target\" })}\n              className=\"flex items-center gap-4 p-4 bg-white/5 rounded-xl border border-white/5 mb-4 hover:bg-white/10 transition-colors group text-left\"\n            >\n              <div className=\"w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center text-xl shadow-inner\">\n                {targetLang.nativeName[0]}\n              </div>\n              <div className=\"flex-1\">\n                <p className=\"text-xs text-slate-400\">To Language</p>\n                <p className=\"text-lg font-semibold text-white\">\n                  {targetLang.nativeName}\n                  <span className=\"text-slate-500 font-normal ml-2 text-sm hidden sm:inline\">{targetLang.name}</span>\n                </p>\n              </div>\n              <ChevronDown size={16} className=\"text-slate-500 group-hover:text-blue-400 transition-colors\" />\n            </button>\n\n            <div \n              dir={targetLang.direction}\n              className=\"flex-1 bg-black/40 rounded-xl p-6 font-serif text-lg leading-relaxed text-slate-300 overflow-y-auto\"\n            >\n              <AnimatePresence mode=\"wait\">\n                {isTranslating ? (\n                  <motion.div \n                    initial={{ opacity: 0 }}\n                    animate={{ opacity: 1 }}\n                    exit={{ opacity: 0 }}\n                    className=\"flex flex-col gap-2\"\n                  >\n                    <div className=\"h-4 bg-white/5 rounded w-full animate-pulse\"></div>\n                    <div className=\"h-4 bg-white/5 rounded w-5/6 animate-pulse\"></div>\n                    <div className=\"h-4 bg-white/5 rounded w-4/6 animate-pulse\"></div>\n                  </motion.div>\n                ) : (\n                  <motion.p\n                    key={translatedText}\n                    initial={{ opacity: 0, x: targetLang.direction === \'rtl\' ? 10 : -10 }}\n                    animate={{ opacity: 1, x: 0 }}\n                    className={!translatedText ? \'text-slate-700\' : \'\'}\n                  >\n                    {translatedText || `Translated content in ${targetLang.name} will appear here...`}\n                  </motion.p>\n                )}\n              </AnimatePresence>\n            </div>\n\n            <div className=\"mt-4 pt-4 border-t border-white/5 flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <button \n                  onClick={() => speak(translatedText, targetLang)}\n                  disabled={!translatedText}\n                  className=\"p-3 bg-blue-500/20 text-blue-400 border border-blue-500/30 hover:bg-blue-500/30 rounded-xl transition-all disabled:opacity-10\"\n                >\n                  <Volume2 size={20} />\n                </button>\n                <button \n                  onClick={() => copyToClipboard(translatedText)}\n                  disabled={!translatedText}\n                  className=\"p-3 bg-white/5 text-slate-400 border border-white/10 rounded-xl hover:bg-white/10 transition-colors disabled:opacity-10\"\n                >\n                  {copied ? <Check size={20} className=\"text-green-500\" /> : <Copy size={20} />}\n                </button>\n              </div>\n              <div className=\"flex items-center gap-2 px-3 py-1 bg-white/5 rounded-full border border-white/5\">\n                <div className={`w-1.5 h-1.5 rounded-full ${translatedText ? \'bg-green-500\' : \'bg-slate-700\'}`} />\n                <span className=\"text-[10px] font-bold text-slate-500 uppercase tracking-widest\">Real-time Stream</span>\n              </div>\n            </div>\n          </div>\n\n          <div className={`bg-slate-900/80 border border-white/10 rounded-2xl p-5 ${targetLang.direction === \'rtl\' ? \'rtl\' : \'\'}`}>\n            <div className=\"flex justify-between items-center mb-2\" dir=\"ltr\">\n              <h2 className=\"text-[11px] font-bold text-slate-500 uppercase tracking-widest\">Node Status</h2>\n              <span className=\"text-[10px] px-2 py-0.5 bg-green-500/10 text-green-500 rounded-full border border-green-500/20\">Synced</span>\n            </div>\n            <div className=\"flex items-center justify-between\">\n              <p className=\"text-xs text-slate-400 font-mono uppercase tracking-tighter\">Availability Zone</p>\n              <p className=\"text-xs text-white font-mono\">ASIA-SOUTH-01</p>\n            </div>\n          </div>\n        </section>\n      </main>\n\n      {/* Footer */}\n      <footer className=\"h-20 mt-auto border-t border-white/5 bg-black/40 backdrop-blur-xl flex items-center justify-between px-8 text-[11px] text-slate-500\">\n        <div className=\"flex gap-8 items-center\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 bg-white/5 rounded-lg flex items-center justify-center border border-white/10\">\n              <ArrowRightLeft size={16} />\n            </div>\n            <span className=\"font-bold text-slate-300\">BHARAT BRIDGE GRID</span>\n          </div>\n          <div className=\"hidden md:flex gap-6\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-green-500\"></span>\n              <span>22 Core Languages Loaded</span>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-orange-500\"></span>\n              <span>Quality Assurance: High</span>\n            </div>\n          </div>\n        </div>\n        <div className=\"flex gap-6 items-center\">\n          <span className=\"uppercase tracking-widest hidden sm:inline\">Architecture: Neural Matrix v4.2.0</span>\n          <div className=\"w-px h-4 bg-white/10 hidden sm:block\"></div>\n          <span className=\"font-mono text-[9px]\">\302\251 2026 BHARATBRIDGE PLATFORM</span>\n        </div>\n      </footer>\n\n      {/* Language Modal (Themed) */}\n      <AnimatePresence>\n        {modalOpen.open && (\n          <LanguageModal \n            isOpen={modalOpen.open} \n            title={modalOpen.type === \"source\" ? \"Source Selection\" : \"Target Selection\"}\n            onClose={() => setModalOpen({ open: false, type: \"source\" })}\n            selectedCode={modalOpen.type === \"source\" ? sourceLang.code : targetLang.code}\n            onSelect={(lang) => {\n              if (modalOpen.type === \"source\") setSourceLang(lang);\n              else setTargetLang(lang);\n            }}\n          />\n        )}\n      </AnimatePresence>\n\n      <style>{`\n        .font-serif { font-family: \'Playfair Display\', serif; }\n        .font-sans { font-family: \'Inter\', system-ui, -apple-system, sans-serif; }\n        ::-webkit-scrollbar { width: 6px; }\n        ::-webkit-scrollbar-track { background: rgba(255,255,255,0.02); }\n        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }\n        ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }\n      `}</style>\n    </div>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
