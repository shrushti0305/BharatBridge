    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  // Room management\n  const sessions = new Map<string, { \n    speaker: WebSocket | null, \n    listeners: Set<WebSocket>,\n    geminiSession: any | null \n  }>();\n\n  // API Routes\n  app.post(\"/api/translate\", async (req, res) => {\n    const { text, sourceLanguage, targetLanguage } = req.body;\n    if (!text || !targetLanguage) return res.status(400).json({ error: \"Missing text or targetLanguage\" });\n    try {\n      const model = \"gemini-3.6-flash\";\n      const prompt = `Translate the following text from ${sourceLanguage || \"auto-detected language\"} to ${targetLanguage}. Return ONLY the translated text, nothing else. Text: \"${text}\"`;\n      const result = await ai.models.generateContent({\n        model,\n        contents: prompt,\n        config: { temperature: 0.1 }\n      });\n      res.json({ translatedText: result.text.trim() });\n    } catch (error: any) {\n      console.error(\"Translation error:\", error);\n      res.status(500).json({ error: error.message });\n    }\n  });\n\n  // WebSocket handling\n  server.on(\'upgrade\', (request, socket, head) => {\n    wss.handleUpgrade(request, socket, head, (ws) => {\n      wss.emit(\'connection\', ws, request);\n    });\n  });\n\n  wss.on(\"connection\", (ws) => {\n    let currentSessionId: string | null = null;\n    let isSpeaker = false;\n\n    ws.on(\"message\", async (data) => {\n      const message = JSON.parse(data.toString());\n\n      if (message.type === \"join\") {\n        const { sessionId, role, gender, targetLang } = message;\n        currentSessionId = sessionId;\n        isSpeaker = role === \"speaker\";\n\n        if (!sessions.has(sessionId)) {\n          sessions.set(sessionId, { speaker: null, listeners: new Set(), geminiSession: null });\n        }\n\n        const session = sessions.get(sessionId)!;\n        if (isSpeaker) {\n          session.speaker = ws;\n          \n          // Connect to Gemini Live for speaker\n          const voiceName = gender === \'female\' ? \'Zephyr\' : \'Fenrir\';\n          \n          try {\n            session.geminiSession = await ai.live.connect({\n              model: \"gemini-2.0-flash-exp\",\n              config: {\n                systemInstruction: `You are a real-time translator. Translate everything you hear from the user into ${targetLang || \'Hindi\'}. Speak ONLY the translation. Provide high-quality audio and transcriptions.`,\n                generationConfig: {\n                  speechConfig: {\n                    voiceConfig: {\n                      prebuiltVoiceConfig: {\n                        voiceName: voiceName\n                      }\n                    }\n                  }\n                },\n                responseModalities: [Modality.AUDIO],\n              },\n              callbacks: {\n                onmessage: (msg: LiveServerMessage) => {\n                  const audio = msg.serverContent?.modelTurn?.parts?.[0]?.inlineData?.data;\n                  \n                  if (audio) {\n                    const payload = JSON.stringify({ type: \"audio\", audio });\n                    if (session.speaker?.readyState === WebSocket.OPEN) {\n                      session.speaker.send(payload);\n                    }\n                    \n                    for (const listener of session.listeners) {\n                      if (listener.readyState === WebSocket.OPEN) {\n                        try { listener.send(payload); } catch (e) { session.listeners.delete(listener); }\n                      } else {\n                        session.listeners.delete(listener);\n                      }\n                    }\n                  }\n\n                  // Handle transcription from specific server messages\n                  const inputTranscription = msg.serverContent?.modelTurn?.parts?.[0]?.text; // In many cases text is returned here\n                  \n                  if (inputTranscription) {\n                    const payload = JSON.stringify({ \n                      type: \"transcription\", \n                      originalText: inputTranscription,\n                      translatedText: inputTranscription, // Live API often returns translation in the same field or specifically\n                      isFinal: true\n                    });\n                    \n                    if (session.speaker?.readyState === WebSocket.OPEN) {\n                      session.speaker.send(payload);\n                    }\n\n                    for (const listener of session.listeners) {\n                      if (listener.readyState === WebSocket.OPEN) {\n                        try { listener.send(payload); } catch (e) { session.listeners.delete(listener); }\n                      }\n                    }\n                  }\n                  \n                  if (msg.serverContent?.interrupted) {\n                    const payload = JSON.stringify({ type: \"interrupted\" });\n                    if (session.speaker?.readyState === WebSocket.OPEN) session.speaker.send(payload);\n                    for (const listener of session.listeners) {\n                      if (listener.readyState === WebSocket.OPEN) listener.send(payload);\n                    }\n                  }\n                }\n              }\n            });\n          } catch (err) {\n            console.error(\"Gemini Live Connection Error:\", err);\n          }\n        } else {\n          session.listeners.add(ws);\n        }\n\n        // Send current listener count\n        const countPayload = JSON.stringify({ type: \"stats\", listeners: session.listeners.size });\n        if (session.speaker?.readyState === WebSocket.OPEN) session.speaker.send(countPayload);\n        session.listeners.forEach(l => {\n          if (l.readyState === WebSocket.OPEN) l.send(countPayload);\n        });\n      }\n\n      if (message.type === \"audio\" && isSpeaker && currentSessionId) {\n        const session = sessions.get(currentSessionId);\n        if (session?.geminiSession) {\n          session.geminiSession.sendRealtimeInput({\n            audio: { data: message.audio, mimeType: \"audio/pcm;rate=16000\" }\n          });\n        }\n      }\n    });\n\n    ws.on(\"close\", () => {\n      if (currentSessionId && sessions.has(currentSessionId)) {\n        const session = sessions.get(currentSessionId)!;\n        if (isSpeaker) {\n          session.speaker = null;\n          if (session.geminiSession) {\n            session.geminiSession.close();\n            session.geminiSession = null;\n          }\n        } else {\n          session.listeners.delete(ws);\n        }\n\n        // Broadcast updated count\n        const countPayload = JSON.stringify({ type: \"stats\", listeners: session.listeners.size });\n        if (session.speaker?.readyState === WebSocket.OPEN) session.speaker.send(countPayload);\n        session.listeners.forEach(l => {\n          if (l.readyState === WebSocket.OPEN) l.send(countPayload);\n        });\n      }\n    });\n  });"
      replacement_content: "  // Room management\n  type LanguageGroup = {\n    geminiSession: any | null;\n    listeners: Set<WebSocket>;\n  };\n\n  type SessionState = {\n    speaker: WebSocket | null;\n    languageGroups: Map<string, LanguageGroup>;\n    speakerGender: string;\n  };\n\n  const sessions = new Map<string, SessionState>();\n\n  // Helper to get or create a language group\n  const getOrCreateLanguageGroup = async (sessionId: string, targetLang: string, gender: string): Promise<LanguageGroup | null> => {\n    const session = sessions.get(sessionId);\n    if (!session) return null;\n\n    if (!session.languageGroups.has(targetLang)) {\n      const voiceName = gender === \'female\' ? \'Zephyr\' : \'Fenrir\';\n      console.log(`Creating Gemini session for room ${sessionId} lang ${targetLang}`);\n      \n      try {\n        const geminiSession = await ai.live.connect({\n          model: \"gemini-2.0-flash-exp\",\n          config: {\n            systemInstruction: `You are a real-time translator. Translate everything you hear from the user into ${targetLang}. Speak ONLY the translation. Provide high-quality audio and transcriptions.`,\n            generationConfig: {\n              speechConfig: {\n                voiceConfig: {\n                  prebuiltVoiceConfig: {\n                    voiceName: voiceName\n                  }\n                }\n              }\n            },\n            responseModalities: [Modality.AUDIO],\n          },\n          callbacks: {\n            onmessage: (msg: LiveServerMessage) => {\n              const audio = msg.serverContent?.modelTurn?.parts?.[0]?.inlineData?.data;\n              const group = session.languageGroups.get(targetLang);\n              if (!group) return;\n\n              if (audio) {\n                const payload = JSON.stringify({ type: \"audio\", audio, targetLang });\n                group.listeners.forEach(l => {\n                  if (l.readyState === WebSocket.OPEN) l.send(payload);\n                });\n                // Also send back to speaker for feedback if needed\n                if (session.speaker?.readyState === WebSocket.OPEN) session.speaker.send(payload);\n              }\n\n              const transcription = msg.serverContent?.modelTurn?.parts?.[0]?.text;\n              if (transcription) {\n                const payload = JSON.stringify({ \n                  type: \"transcription\", \n                  originalText: transcription, // This is actually the translation\n                  translatedText: transcription,\n                  targetLang,\n                  isFinal: true\n                });\n                group.listeners.forEach(l => {\n                  if (l.readyState === WebSocket.OPEN) l.send(payload);\n                });\n                if (session.speaker?.readyState === WebSocket.OPEN) session.speaker.send(payload);\n              }\n\n              if (msg.serverContent?.interrupted) {\n                const payload = JSON.stringify({ type: \"interrupted\", targetLang });\n                group.listeners.forEach(l => {\n                  if (l.readyState === WebSocket.OPEN) l.send(payload);\n                });\n              }\n            }\n          }\n        });\n        session.languageGroups.set(targetLang, { geminiSession, listeners: new Set() });\n      } catch (err) {\n        console.error(`Gemini connection failed for ${targetLang}:`, err);\n        return null;\n      }\n    }\n    return session.languageGroups.get(targetLang)!;\n  };\n\n  // WebSocket handling\n  server.on(\'upgrade\', (request, socket, head) => {\n    wss.handleUpgrade(request, socket, head, (ws) => {\n      wss.emit(\'connection\', ws, request);\n    });\n  });\n\n  wss.on(\"connection\", (ws) => {\n    let currentSessionId: string | null = null;\n    let currentRole: \'speaker\' | \'listener\' | null = null;\n    let currentLang: string | null = null;\n\n    ws.on(\"message\", async (data) => {\n      const message = JSON.parse(data.toString());\n\n      if (message.type === \"join\") {\n        const { sessionId, role, gender, targetLang } = message;\n        currentSessionId = sessionId;\n        currentRole = role;\n        currentLang = targetLang || \"hi\";\n\n        if (!sessions.has(sessionId)) {\n          sessions.set(sessionId, { \n            speaker: null, \n            languageGroups: new Map(),\n            speakerGender: gender || \"male\"\n          });\n        }\n\n        const session = sessions.get(sessionId)!;\n\n        if (role === \"speaker\") {\n          session.speaker = ws;\n          session.speakerGender = gender || \"male\";\n          // Create the speaker\'s preferred language group immediately\n          await getOrCreateLanguageGroup(sessionId, currentLang!, session.speakerGender);\n        } else {\n          const group = await getOrCreateLanguageGroup(sessionId, currentLang!, session.speakerGender);\n          if (group) {\n            group.listeners.add(ws);\n          }\n        }\n\n        // Broadcast stats\n        const totalListeners = Array.from(session.languageGroups.values()).reduce((acc, g) => acc + g.listeners.size, 0);\n        const statsPayload = JSON.stringify({ type: \"stats\", listeners: totalListeners });\n        if (session.speaker?.readyState === WebSocket.OPEN) session.speaker.send(statsPayload);\n        session.languageGroups.forEach(g => {\n          g.listeners.forEach(l => {\n            if (l.readyState === WebSocket.OPEN) l.send(statsPayload);\n          });\n        });\n      }\n\n      if (message.type === \"audio\" && currentRole === \"speaker\" && currentSessionId) {\n        const session = sessions.get(currentSessionId);\n        if (session) {\n          // Pipe audio to ALL active language sessions\n          session.languageGroups.forEach(group => {\n            if (group.geminiSession) {\n              group.geminiSession.sendRealtimeInput({\n                audio: { data: message.audio, mimeType: \"audio/pcm;rate=16000\" }\n              });\n            }\n          });\n        }\n      }\n    });\n\n    ws.on(\"close\", () => {\n      if (currentSessionId && sessions.has(currentSessionId)) {\n        const session = sessions.get(currentSessionId)!;\n        if (currentRole === \"speaker\") {\n          session.speaker = null;\n          // Close all Gemini sessions for this room\n          session.languageGroups.forEach(g => {\n            if (g.geminiSession) g.geminiSession.close();\n          });\n          session.languageGroups.clear();\n        } else if (currentLang) {\n          const group = session.languageGroups.get(currentLang);\n          if (group) {\n            group.listeners.delete(ws);\n            // Optional: Close Gemini session if no listeners left in this language\n            if (group.listeners.size === 0) {\n              if (group.geminiSession) group.geminiSession.close();\n              session.languageGroups.delete(currentLang);\n            }\n          }\n        }\n\n        // Broadcast stats\n        const totalListeners = Array.from(session.languageGroups.values()).reduce((acc, g) => acc + g.listeners.size, 0);\n        const statsPayload = JSON.stringify({ type: \"stats\", listeners: totalListeners });\n        if (session.speaker?.readyState === WebSocket.OPEN) session.speaker.send(statsPayload);\n        session.languageGroups.forEach(g => {\n          g.listeners.forEach(l => {\n            if (l.readyState === WebSocket.OPEN) l.send(statsPayload);\n          });\n        });\n      }\n    });\n  });"
    }
    instruction: "Refactor server to support multiple target languages per session, grouping listeners by language and maintaining one Gemini session per language."
  }
}
