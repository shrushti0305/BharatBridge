        }
        lines {
          text: "      return `[${time}] ${m.sourceLang?.toUpperCase() || \'SRC\'}: ${m.originalText}\\n[${time}] ${m.targetLang?.toUpperCase() || \'TRG\'}: ${m.translatedText}\\n`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
