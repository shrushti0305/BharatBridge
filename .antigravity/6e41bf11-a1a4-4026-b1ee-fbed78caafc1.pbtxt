        }
        lines {
          text: "    .map(m => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const time = m.timestamp ? new Date(m.timestamp.seconds * 1000).toLocaleTimeString() : \"Pending\";"
