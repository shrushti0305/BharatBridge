        }
        lines {
          text: "    if (!text) return;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    window.speechSynthesis.cancel();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const utterance = new SpeechSynthesisUtterance(text);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const voices = window.speechSynthesis.getVoices();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const voice = voices.find(v => v.lang.startsWith(lang.code)) || voices.find(v => v.lang.includes(\"IN\"));"
