        lines {
          text: "const exportTranscript = (messages: FBMessage[], sessionName?: string, sessionId?: string) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (messages.length === 0) return;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const sessionInfo = `Session: ${sessionName || \'Unknown\'}\\nID: ${sessionId || \'N/A\'}\\nDate: ${new Date().toLocaleString()}\\n\\n`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
