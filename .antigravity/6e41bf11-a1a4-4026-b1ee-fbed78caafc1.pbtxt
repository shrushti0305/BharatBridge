    replacement_chunks {
      target_content: "  const toggleListening = () => {\n    if (isListening) {\n      setIsListening(false);\n      return;\n    }\n    \n    // In a real app, we\'d use Web Speech API here\n    setIsListening(true);\n    setTimeout(() => {\n      if (Math.random() > 0.5) {\n        setInputText(\"\340\244\250\340\244\256\340\244\270\340\245\215\340\244\244\340\245\207, \340\244\206\340\244\252 \340\244\225\340\245\210\340\244\270\340\245\207 \340\244\271\340\245\210\340\244\202?\");\n      } else {\n        setInputText(\"Hello, how are you today?\");\n      }\n      setIsListening(false);\n    }, 3000);\n  };\n"
      replacement_content: "  const toggleListening = async () => {\n    if (isListening) {\n      setIsListening(false);\n      if (inputAudioCtxRef.current) {\n        inputAudioCtxRef.current.close();\n        inputAudioCtxRef.current = null;\n      }\n      return;\n    }\n\n    try {\n      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\n      setIsListening(true);\n\n      if (!inputAudioCtxRef.current) {\n        inputAudioCtxRef.current = new AudioContext({ sampleRate: 16000 });\n      }\n      const ctx = inputAudioCtxRef.current;\n      const source = ctx.createMediaStreamSource(stream);\n      const processor = ctx.createScriptProcessor(4096, 1, 1);\n      \n      source.connect(processor);\n      processor.connect(ctx.destination);\n\n      processor.onaudioprocess = (e) => {\n        if (!isListening) return;\n        const pcm = e.inputBuffer.getChannelData(0);\n        const base64 = pcmToBase64(pcm);\n        \n        if (isLive && ws && ws.readyState === WebSocket.OPEN) {\n          ws.send(JSON.stringify({ type: \"audio\", audio: base64 }));\n        } else if (!isLive) {\n          // Fallback for non-live voice input (could use speech-to-text here if needed)\n          // For now, we\'ll keep the existing behavior of just setting listening state\n        }\n      };\n\n    } catch (error) {\n      console.error(\"Microphone access denied:\", error);\n      alert(\"Microphone access is required for voice translation.\");\n    }\n  };\n"
    }
    instruction: "Update toggleListening to stream audio to WebSocket when live session is active"
  }
}
