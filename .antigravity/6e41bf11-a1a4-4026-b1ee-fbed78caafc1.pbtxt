    instruction: "Update live session logic to include WebSocket and Audio streaming"
    replacement_infos {
      original_chunk {
        target_content: "  const startLiveSession = async () => {\n    if (!user) {\n      await signInWithGoogle();\n      return;\n    }\n    try {\n      const sessionData = {\n        name: `Live Session - ${sourceLang.name} to ${targetLang.name}`,\n        createdAt: serverTimestamp(),\n        speakerId: user.uid,\n        sourceLang: sourceLang.code,\n        targetLang: targetLang.code,\n        status: \'active\'\n      };\n      const docRef = await addDoc(collection(db, \"sessions\"), sessionData);\n      setCurrentSession({ id: docRef.id, ...sessionData } as Session);\n      setIsLive(true);\n      setSessionRole(\'speaker\');\n    } catch (error) {\n      handleFirestoreError(error, OperationType.CREATE, \"sessions\");\n    }\n  };\n\n  const endLiveSession = async () => {\n    if (!currentSession || sessionRole !== \'speaker\') return;\n    try {\n      await updateDoc(doc(db, \"sessions\", currentSession.id), {\n        status: \'finished\'\n      });\n      setIsLive(false);\n      setSessionRole(null);\n      setCurrentSession(null);\n    } catch (error) {\n      handleFirestoreError(error, OperationType.UPDATE, `sessions/${currentSession.id}`);\n    }\n  };\n\n  const joinLiveSession = async (sessionId: string) => {\n    if (!user) {\n      await signInWithGoogle();\n      return;\n    }\n    try {\n      // For simplicity, just join if exists\n      const docRef = doc(db, \"sessions\", sessionId);\n      const snapshot = await getDocs(query(collection(db, \"sessions\"), where(\"__name__\", \"==\", sessionId)));\n      if (snapshot.empty) {\n        alert(\"Session not found\");\n        return;\n      }\n      const data = snapshot.docs[0].data();\n      setCurrentSession({ id: snapshot.docs[0].id, ...data } as Session);\n      setIsLive(true);\n      setSessionRole(\'listener\');\n      \n      // Update local languages to match session\n      const s = LANGUAGES.find(l => l.code === data.sourceLang);\n      const t = LANGUAGES.find(l => l.code === data.targetLang);\n      if (s) setSourceLang(s);\n      if (t) setTargetLang(t);\n    } catch (error) {\n      handleFirestoreError(error, OperationType.GET, `sessions/${sessionId}`);\n    }\n  };\n"
        replacement_content: "  const playAudioChunk = (base64: string) => {\n    if (!outputAudioCtxRef.current) {\n      outputAudioCtxRef.current = new AudioContext({ sampleRate: 24000 });\n    }\n    const ctx = outputAudioCtxRef.current;\n    const pcm = base64ToPcm(base64);\n    const buffer = ctx.createBuffer(1, pcm.length, 24000);\n    buffer.getChannelData(0).set(pcm);\n    const source = ctx.createBufferSource();\n    source.buffer = buffer;\n    source.connect(ctx.destination);\n    \n    const startTime = Math.max(ctx.currentTime, nextStartTimeRef.current);\n    source.start(startTime);\n    nextStartTimeRef.current = startTime + buffer.duration;\n  };\n\n  const startLiveSession = async () => {\n    if (!user) {\n      await signInWithGoogle();\n      return;\n    }\n    try {\n      const sessionData = {\n        name: `Live Session - ${sourceLang.name} to ${targetLang.name}`,\n        createdAt: serverTimestamp(),\n        speakerId: user.uid,\n        speakerGender: profile.gender,\n        sourceLang: sourceLang.code,\n        targetLang: targetLang.code,\n        status: \'active\'\n      };\n      const docRef = await addDoc(collection(db, \"sessions\"), sessionData);\n      const sessionId = docRef.id;\n      setCurrentSession({ id: sessionId, ...sessionData } as Session);\n      setIsLive(true);\n      setSessionRole(\'speaker\');\n\n      // Setup WebSocket\n      const socket = new WebSocket(`${window.location.protocol === \"https:\" ? \"wss:\" : \"ws:\"}//${window.location.host}`);\n      socket.onopen = () => {\n        socket.send(JSON.stringify({ \n          type: \"join\", \n          sessionId, \n          role: \"speaker\", \n          gender: profile.gender,\n          targetLang: targetLang.code\n        }));\n      };\n      socket.onmessage = (event) => {\n        const msg = JSON.parse(event.data);\n        if (msg.type === \"audio\") playAudioChunk(msg.audio);\n        if (msg.type === \"interrupted\") {\n          // Clear queue\n          nextStartTimeRef.current = 0;\n        }\n      };\n      setWs(socket);\n    } catch (error) {\n      handleFirestoreError(error, OperationType.CREATE, \"sessions\");\n    }\n  };\n\n  const endLiveSession = async () => {\n    if (!currentSession || sessionRole !== \'speaker\') return;\n    try {\n      await updateDoc(doc(db, \"sessions\", currentSession.id), {\n        status: \'finished\'\n      });\n      setIsLive(false);\n      setSessionRole(null);\n      setCurrentSession(null);\n      if (ws) ws.close();\n      setWs(null);\n      if (inputAudioCtxRef.current) inputAudioCtxRef.current.close();\n      if (outputAudioCtxRef.current) outputAudioCtxRef.current.close();\n      inputAudioCtxRef.current = null;\n      outputAudioCtxRef.current = null;\n    } catch (error) {\n      handleFirestoreError(error, OperationType.UPDATE, `sessions/${currentSession.id}`);\n    }\n  };\n\n  const joinLiveSession = async (sessionId: string) => {\n    if (!user) {\n      await signInWithGoogle();\n      return;\n    }\n    try {\n      const snapshot = await getDocs(query(collection(db, \"sessions\"), where(\"__name__\", \"==\", sessionId)));\n      if (snapshot.empty) {\n        alert(\"Session not found\");\n        return;\n      }\n      const data = snapshot.docs[0].data();\n      setCurrentSession({ id: snapshot.docs[0].id, ...data } as Session);\n      setIsLive(true);\n      setSessionRole(\'listener\');\n      \n      const s = LANGUAGES.find(l => l.code === data.sourceLang);\n      const t = LANGUAGES.find(l => l.code === data.targetLang);\n      if (s) setSourceLang(s);\n      if (t) setTargetLang(t);\n\n      // Setup WebSocket\n      const socket = new WebSocket(`${window.location.protocol === \"https:\" ? \"wss:\" : \"ws:\"}//${window.location.host}`);\n      socket.onopen = () => {\n        socket.send(JSON.stringify({ type: \"join\", sessionId, role: \"listener\" }));\n      };\n      socket.onmessage = (event) => {\n        const msg = JSON.parse(event.data);\n        if (msg.type === \"audio\") playAudioChunk(msg.audio);\n      };\n      setWs(socket);\n    } catch (error) {\n      handleFirestoreError(error, OperationType.GET, `sessions/${sessionId}`);\n    }\n  };\n"
      }
      num_matches: 1
    }
  }
