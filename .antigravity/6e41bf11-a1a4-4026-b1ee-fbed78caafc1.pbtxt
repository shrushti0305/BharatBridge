        }
        lines {
          text: "    }, delay);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return () => clearTimeout(timer);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  }, [inputText, targetLang, isLive, isListening]);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
