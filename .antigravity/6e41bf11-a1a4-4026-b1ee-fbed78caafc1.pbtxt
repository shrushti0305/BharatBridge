    tool_summary: "Firestore rules creation"
    tool_action: "Creating Firestore rules"
    started_at {
      seconds: 1786283939
      nanos: 802289400
    }
  }
  file_change {
    absolute_path_uri: "file:///firestore.rules"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "rules_version = \'2\';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // Global Deny\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(data) {\n      return isSignedIn() && data.speakerId == request.auth.uid;\n    }\n\n    function isAdmin() {\n      return isSignedIn() && request.auth.token.email == \'shrushti.cyda@gmail.com\';\n    }\n\n    function isValidId(id) {\n      return id is string && id.size() <= 128 && id.matches(\'^[a-zA-Z0-9_\\\\-]+$\');\n    }\n\n    function incoming() {\n      return request.resource.data;\n    }\n\n    function existing() {\n      return resource.data;\n    }\n\n    // Sessions\n    match /sessions/{sessionId} {\n      allow get: if isSignedIn();\n      allow list: if isAdmin() || (isSignedIn() && (resource.data.speakerId == request.auth.uid));\n      \n      allow create: if isSignedIn() \n        && isValidId(sessionId)\n        && isValidSession(incoming())\n        && incoming().speakerId == request.auth.uid;\n        \n      allow update: if isSignedIn()\n        && isValidSession(incoming())\n        && (\n          (isOwner(existing()) && incoming().diff(existing()).affectedKeys().hasOnly([\'status\', \'name\']))\n          || isAdmin()\n        );\n        \n      allow delete: if isAdmin();\n\n      // Messages subcollection\n      match /messages/{messageId} {\n        allow list: if isSignedIn();\n        allow get: if isSignedIn();\n        \n        allow create: if isSignedIn()\n          && isValidId(messageId)\n          && isValidMessage(incoming())\n          && (isAdmin() || (get(/databases/$(database)/documents/sessions/$(sessionId)).data.speakerId == request.auth.uid && get(/databases/$(database)/documents/sessions/$(sessionId)).data.status == \'active\'));\n          \n        allow update, delete: if isAdmin();\n      }\n    }\n\n    function isValidSession(data) {\n      return data.keys().hasAll([\'createdAt\', \'speakerId\', \'status\'])\n        && data.createdAt == request.time\n        && data.speakerId is string\n        && data.status in [\'active\', \'finished\']\n        && (!data.keys().contains(\'name\') || (data.name is string && data.name.size() <= 100));\n    }\n\n    function isValidMessage(data) {\n      return data.keys().hasAll([\'text\', \'translatedText\', \'timestamp\', \'senderId\'])\n        && data.text is string && data.text.size() <= 5000\n        && data.translatedText is string && data.translatedText.size() <= 5000\n        && data.timestamp == request.time\n        && data.senderId == request.auth.uid;\n    }\n  }\n}\n"
    }
    diff {
      unified_diff {
        lines {
