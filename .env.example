# ===================================================================
# BHARATBRIDGE MULTI-AI PROVIDER CONFIGURATION TEMPLATE
# ===================================================================

# SERVER CONFIGURATION
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
DISABLE_HMR="false"

# PROVIDER ROUTING SWITCHES (gemini | azure | bhashini | smallest | google | webspeech)
TRANSLATION_PRIMARY="gemini"
TRANSLATION_FALLBACK="azure"
TTS_PRIMARY="smallest"
TTS_FALLBACK="azure"
STT_PROVIDER="webspeech"

# GOOGLE GEMINI AI API (Required for Context-Aware Translation & Summaries)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL_TRANSLATION="gemini-2.5-flash"
GEMINI_MODEL_SUMMARY="gemini-2.5-flash"

# AZURE COGNITIVE SERVICES (Translation & High-Fidelity Regional Speech)
AZURE_SPEECH_KEY="YOUR_AZURE_SPEECH_KEY"
AZURE_SPEECH_REGION="centralindia" # Options: centralindia, eastus, southindia

AZURE_TRANSLATOR_KEY="YOUR_AZURE_TRANSLATOR_KEY"
AZURE_TRANSLATOR_REGION="centralindia"

# SMALLEST.AI WAVES SPEECH API (Sub-100ms Ultra-Fast Voice Synthesis)
SMALLEST_API_KEY="your-smallest-api-key"
SMALLEST_VOICE_ID="emily" # Options: emily, arman, diya, radhika

# AI4BHARAT BHASHINI API (MeitY Govt of India NMT Regional Translation)
BHASHINI_API_KEY="YOUR_BHASHINI_API_KEY"
BHASHINI_ENDPOINT="https://dhruva-api.bhashini.gov.in/services/inference/v2/pipeline"
BHASHINI_PIPELINE_ID="YOUR_BHASHINI_PIPELINE_ID"

# AZURE BLOB STORAGE (Dual-Format JSON & UTF-8 BOM CSV Caption Backup)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT_NAME;AccountKey=YOUR_ACCOUNT_KEY;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_NAME="bharat-bridge-captions"

# FIREBASE CLOUD FIRESTORE
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
ADMIN_METRICS_SALT=change-me-long-random
ADMIN_TOKEN=change-me-long-random
