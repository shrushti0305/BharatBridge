# ===================================================================
# BHARATBRIDGE MULTI-AI PROVIDER CONFIGURATION TEMPLATE
# ===================================================================

# SERVER CONFIGURATION
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
DISABLE_HMR="false"

# PROVIDER ROUTING SWITCHES (gemini | azure | google | webspeech)
TRANSLATION_PRIMARY="gemini"
TRANSLATION_FALLBACK="azure"
TTS_PRIMARY="azure"
TTS_FALLBACK="google"
STT_PROVIDER="webspeech"

# GOOGLE GEMINI AI API (Required for Context-Aware Translation & Summaries)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL_TRANSLATION="gemini-3.8-flash"
GEMINI_MODEL_SUMMARY="gemini-3.8-flash"

# AZURE COGNITIVE SERVICES (Translation & High-Fidelity Regional Speech)
AZURE_SPEECH_KEY="YOUR_AZURE_SPEECH_KEY"
AZURE_SPEECH_REGION="centralindia" # Options: centralindia, eastus, southindia

AZURE_TRANSLATOR_KEY="YOUR_AZURE_TRANSLATOR_KEY"
AZURE_TRANSLATOR_REGION="centralindia"

# AZURE BLOB STORAGE (Dual-Format JSON & UTF-8 BOM CSV Caption Backup)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT_NAME;AccountKey=YOUR_ACCOUNT_KEY;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_NAME="bharat-bridge-captions"

# FIREBASE AUTH CONFIGURATION
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
ADMIN_METRICS_SALT="YOUR_ADMIN_METRICS_SALT"
ADMIN_TOKEN="YOUR_ADMIN_TOKEN"

