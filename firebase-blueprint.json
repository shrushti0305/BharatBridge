{
  "entities": {
    "Session": {
      "title": "Translation Session",
      "description": "A live translation room",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "speakerId": { "type": "string" },
        "sourceLang": { "type": "string" },
        "targetLang": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "finished"] }
      },
      "required": ["createdAt", "speakerId", "status"]
    },
    "Message": {
      "title": "Translation Message",
      "description": "A single piece of translated speech",
      "type": "object",
      "properties": {
        "originalText": { "type": "string" },
        "translatedText": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "senderId": { "type": "string" },
        "sourceLang": { "type": "string" },
        "targetLang": { "type": "string" }
      },
      "required": ["originalText", "translatedText", "timestamp", "senderId"]
    }
  },
  "firestore": {
    "/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Active and past sessions"
    },
    "/sessions/{sessionId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a session"
    }
  }
}
