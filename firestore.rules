rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return isSignedIn() && data.speakerId == request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'shrushti.cyda@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Sessions
    match /sessions/{sessionId} {
      allow get: if isSignedIn();
      allow list: if isAdmin() || (isSignedIn() && (resource.data.speakerId == request.auth.uid));
      
      allow create: if isSignedIn() 
        && isValidId(sessionId)
        && isValidSession(incoming())
        && incoming().speakerId == request.auth.uid;
        
      allow update: if isSignedIn()
        && isValidSession(incoming())
        && (
          (isOwner(existing()) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'name']))
          || isAdmin()
        );
        
      allow delete: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        allow list: if isSignedIn();
        allow get: if isSignedIn();
        
        allow create: if isSignedIn()
          && isValidId(messageId)
          && isValidMessage(incoming())
          && (isAdmin() || (get(/databases/$(database)/documents/sessions/$(sessionId)).data.speakerId == request.auth.uid && get(/databases/$(database)/documents/sessions/$(sessionId)).data.status == 'active'));
          
        allow update, delete: if isAdmin();
      }
    }

    function isValidSession(data) {
      return data.keys().hasAll(['createdAt', 'speakerId', 'status'])
        && data.createdAt == request.time
        && data.speakerId is string
        && data.status in ['active', 'finished']
        && (!data.keys().contains('name') || (data.name is string && data.name.size() <= 1000));
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['originalText', 'translatedText', 'timestamp', 'senderId'])
        && data.originalText is string
        && data.translatedText is string
        && data.timestamp == request.time
        && data.senderId == request.auth.uid;
    }
  }
}
